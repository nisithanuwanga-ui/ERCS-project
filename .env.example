# Generate a URL-safe hexadecimal local Compose password; do not commit .env.
POSTGRES_PASSWORD=replace-with-generated-hexadecimal-password
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
# Only compose.external.yaml reads DATABASE_URL; preserve existing SSL parameters.
# DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require
