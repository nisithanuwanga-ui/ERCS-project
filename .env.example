NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Development also trusts localhost on the same port (and vice versa).
# Optional additional exact origins, comma-separated; never use a wildcard.
# TRUSTED_ORIGINS=https://another-explicitly-trusted-ui.example
DATABASE_URL=postgresql://ercs:replace-local-password@127.0.0.1:5432/ercs
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=0
# Supply bootstrap values temporarily to npm run db:bootstrap. Never commit them.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=
