{
  "name": "devops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:full": "concurrently -k \"npm run dev:api\" \"npm run dev\"",
    "dev:database": "tsx scripts/local-database.ts",
    "db:migrate": "tsx backend/src/migrate.ts",
    "db:bootstrap": "tsx backend/src/bootstrap.ts",
    "typecheck": "tsc -b && tsc --noEmit -p backend/tsconfig.json",
    "build:api": "tsc -p backend/tsconfig.json",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test",
    "db:provision-dev": "tsx scripts/provision-development.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "test:demo": "tsx scripts/verify-demo.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
